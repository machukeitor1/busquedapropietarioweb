PORT=3000
# Origen del frontend que consume la API (CORS). * para desarrollo local.
CORS_ORIGIN=*
# Timeout (ms) para las peticiones salientes al SII / TGR
SII_TIMEOUT=15000
TGR_TIMEOUT=30000
# Playwright: "true" para headless (sin ventana visible), "false" para debug
PLAYWRIGHT_HEADLESS=true
# Timeout (ms) para el login automatizado con Playwright
PLAYWRIGHT_TIMEOUT=30000
# Duración de la sesión SII en segundos (defecto: 300 = 5 min)
SESSION_TTL_SECONDS=300
# Intervalo de limpieza de sesiones expiradas en segundos
SESSION_CLEANUP_SECONDS=60
